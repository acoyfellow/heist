{
	"name": "heist",
	"main": "src/front/index.ts",
	"compatibility_date": "2026-09-01",
	"account_id": "bfcb6ac5b3ceaf42a09607f6f7925823",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "heist.coey.dev", "custom_domain": true }],
	"assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
	"services": [{ "binding": "CORE", "service": "heist-core" }],
	"ratelimits": [
		{ "name": "ATTEMPT_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
		{ "name": "READ_LIMIT", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } }
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Arcade"] }, { "tag": "v2", "deleted_classes": ["Arcade"] }]
}
